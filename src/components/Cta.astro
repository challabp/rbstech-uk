---
interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Tell us which work takes up too much of your team’s time.',
  text = 'We will tell you honestly whether an AI agent can help, and what it would involve.',
} = Astro.props;
---

<section class="cta section-tight">
  <div class="wrap">
    <h2>{heading}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <a class="btn btn-solid" href="/contact/">Start a conversation</a>
      <a class="btn btn-ghost" href="/solutions/">Browse the solutions</a>
    </div>
  </div>
</section>
