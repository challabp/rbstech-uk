---
import type { UseCase } from '../data/usecases';
import { industryBySlug } from '../data/industries';
import { plain } from '../data/plain';

interface Props {
  u: UseCase;
  showIndustry?: boolean;
}
const { u, showIndustry = false } = Astro.props;
const ind = industryBySlug[u.industry];
const kind = plain[u.pattern].label;
const hay = `${u.name} ${u.summary} ${u.tags.join(' ')} ${ind.name} ${kind}`.toLowerCase();
---

<a class="uc" href={`/solutions/${u.slug}/`} data-industry={u.industry} data-pattern={u.pattern} data-hay={hay}>
  <span class="uc-name">{u.name}</span>
  <span class="uc-sum">{u.summary}</span>
  <span class="uc-meta">{showIndustry ? ind.name : kind}</span>
</a>
