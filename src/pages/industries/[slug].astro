---
import Base from '../../layouts/Base.astro';
import UseCaseRow from '../../components/UseCaseRow.astro';
import Cta from '../../components/Cta.astro';
import { industries, type Industry } from '../../data/industries';
import { byIndustry } from '../../data/usecases';
import { stages } from '../../data/accounting';

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}
interface Props {
  ind: Industry;
}
const { ind } = Astro.props;
const cases = byIndustry(ind.slug);
const isAccounting = ind.slug === 'accounting-audit';
const groups = isAccounting
  ? stages.map((s) => ({ ...s, cases: cases.filter((u) => u.stage === s.slug) }))
  : [
      { slug: 'core', name: '', blurb: '', cases: cases.filter((u) => !u.isNew) },
      { slug: 'recent', name: 'Added for 2026', blurb: 'Newer problems, and older ones that the latest AI has made practical to solve.', cases: cases.filter((u) => u.isNew) },
    ].filter((g) => g.cases.length);

// How the pieces fit together inside a firm, shown on the accounting page only.
const firmLayers = [
  {
    name: 'Connect the firm’s systems',
    text: 'Engagement, practice, document and staffing systems linked together, so information is entered once and is available everywhere. A group of firms can see itself as one business.',
  },
  {
    name: 'Follow your way of working',
    text: 'Your audit manuals, templates and review standards are built into the agents. Each firm keeps its own methods, and the agents follow them.',
  },
  {
    name: 'Agents on the routine work',
    text: 'Agents clean the data, chase the documents, prepare the workpapers and check them. They share the same information, so a document accepted on Monday is in the workpaper and on the schedule by Tuesday.',
  },
  {
    name: 'People on the judgement',
    text: 'Every conclusion, sign-off and client decision stays with a qualified person. The agents prepare, check and chase, and they always show their evidence.',
  },
];
---

<Base title={`${ind.name} AI agents`} description={`${ind.intro.split('. ')[0]}. ${cases.length} AI agent solutions for ${ind.name.toLowerCase()}.`}>
  <section class="band page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/industries/">Industries</a></nav>
      <h1>{ind.name}</h1>
      <p class="lede">{ind.intro}</p>
    </div>
  </section>

  {
    isAccounting && (
      <section class="section-tight fit">
        <div class="wrap">
          <div class="head">
            <h2>More capacity, without more people.</h2>
            <p class="lede">Time is lost in the handovers: from the client to the request list, from the request list to the workpaper, from the workpaper to the schedule. We build agents that work across all of them.</p>
          </div>
          <ol class="layers">
            {firmLayers.map((l) => (
              <li>
                <h3>{l.name}</h3>
                <p class="muted">{l.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section-tight">
    <div class="wrap">
      {
        groups.map((g) => (
          <div class="group">
            {g.name && (
              <div class="group-head">
                <h2>{g.name}</h2>
                <p class="muted">{g.blurb}</p>
              </div>
            )}
            <div class="uc-list">
              {g.cases.map((u) => (
                <UseCaseRow u={u} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-tight context">
    <div class="wrap cols">
      <div>
        <h2>Systems we work with</h2>
        <ul class="ticks">
          {ind.systems.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h2>Rules and standards we design for</h2>
        <ul class="ticks">
          {ind.rules.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h2>Good places to start</h2>
        <ul class="ticks">
          {ind.focus.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Cta
    heading={isAccounting ? 'Show us one engagement, start to finish.' : undefined}
    text={isAccounting ? 'We will look at where the hours go, choose the first two agents worth building, and run them on last year’s file so you can compare the result with what your team produced.' : undefined}
  />
</Base>

<style>
  .fit {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .layers {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .layers li {
    border-top: 4px solid var(--green-700);
    padding-top: 1rem;
  }
  .layers li:last-child {
    border-top-color: var(--marigold);
  }
  .layers h3 {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }
  .group + .group {
    margin-top: 4rem;
  }
  .group-head {
    display: grid;
    gap: 0.4rem 3rem;
    margin-bottom: 1.25rem;
    align-items: baseline;
  }
  @media (min-width: 56rem) {
    .group-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
  .group-head h2 {
    font-size: var(--step-3);
  }
  .context {
    background: var(--white);
    border-top: 1px solid var(--line);
  }
  .cols {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .cols h2 {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1.5px solid var(--ink);
  }
  .cols li {
    color: var(--muted);
  }
</style>
