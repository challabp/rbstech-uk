---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { patterns } from '../data/patterns';
import { byPattern } from '../data/usecases';
import { stack, controls, approvalClasses } from '../data/stack';
import { renderDiagram } from '../lib/diagram';

const generic = (s: string) => s.replace('{trigger}', 'Trigger').replace('{system}', 'System of record').replace('{knowledge}', 'Knowledge sources');
---

<Base title="Engineering" description="How RBS Technologies builds AI agents: nine architecture patterns, a vendor-neutral stack, evaluation gates and human approval classes.">
  <section class="band page-hero">
    <div class="wrap">
      <h1>The model is one component. The system around it is the product.</h1>
      <p class="lede">Orchestration, retrieval, evaluation, approval gates and monitoring decide whether an agent can be trusted with real work. This is how we build them.</p>
      <nav class="jump" aria-label="On this page">
        <a href="#stack">Stack</a>
        <a href="#patterns">Patterns</a>
        <a href="#controls">Controls</a>
      </nav>
    </div>
  </section>

  <section class="section" id="stack">
    <div class="wrap">
      <div class="head">
        <h2>The stack, layer by layer.</h2>
        <p class="lede">We are not tied to a model provider or a cloud. For each layer, this is what we select from and how we decide.</p>
      </div>
      <div class="layers">
        {
          stack.map((l) => (
            <article class="layer">
              <div>
                <h3>{l.name}</h3>
                <p class="muted">{l.role}</p>
              </div>
              <p>{l.choose}</p>
              <ul class="tags">
                {l.options.map((o) => (
                  <li class="tag">{o}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="small muted" style="margin-top:1.5rem">Product names are examples of the technology we work with and belong to their owners. They do not indicate a partnership.</p>
    </div>
  </section>

  <section class="section white" id="patterns">
    <div class="wrap">
      <div class="head">
        <h2>Nine patterns, each with a reason to exist.</h2>
        <p class="lede">Picking the wrong shape is the commonest way agent projects fail. We match the pattern to the risk in the work.</p>
      </div>
      <div class="legend" style="margin-bottom:2.5rem">
        <span><i class="k-agent"></i>Agent reasoning</span>
        <span><i class="k-tool"></i>System or tool</span>
        <span><i class="k-data"></i>Data and knowledge</span>
        <span><i class="k-human"></i>Person decides</span>
      </div>
      {
        patterns.map((p) => (
          <article class="pattern" id={p.slug}>
            <div class="stack">
              <h3>{p.name}</h3>
              <p class="narrow muted">{p.short}</p>
              <p>{p.why}</p>
              <dl class="facts">
                <div>
                  <dt>Use it when</dt>
                  <dd>{p.when}</dd>
                </div>
                <div>
                  <dt>Human control</dt>
                  <dd>{p.control}</dd>
                </div>
                <div>
                  <dt>We measure</dt>
                  <dd>{p.measures.join('. ')}.</dd>
                </div>
                <div>
                  <dt>Typical build</dt>
                  <dd>{p.stack.join('. ')}.</dd>
                </div>
              </dl>
              <p>
                <a href={`/solutions/?pattern=${p.slug}`}>{byPattern(p.slug).length} solutions use this pattern</a>
              </p>
            </div>
            <div class="dg-frame" set:html={renderDiagram(p, generic)} />
          </article>
        ))
      }
    </div>
  </section>

  <section class="band section" id="controls">
    <div class="wrap">
      <div class="head">
        <h2>Controls that ship on day one.</h2>
        <p class="lede">These are part of the build, priced into it, and present in the first release.</p>
      </div>
      <div class="controls">
        {
          controls.map((c) => (
            <div>
              <h3>{c.name}</h3>
              <p class="muted">{c.text}</p>
            </div>
          ))
        }
      </div>

      <h3 class="sub">Four approval classes</h3>
      <dl class="facts">
        {
          approvalClasses.map((a) => (
            <div>
              <dt>{a.name}</dt>
              <dd>{a.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Cta heading="Have an architecture you want a second opinion on?" text="Send us the design or the problem. We will tell you which pattern we would use and why." />
</Base>

<style>
  .jump {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  .white {
    background: var(--white);
    border-block: 1px solid var(--line);
  }
  .layers {
    border-top: 1.5px solid var(--ink);
  }
  .layer {
    display: grid;
    gap: 1rem 2.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 60rem) {
    .layer {
      grid-template-columns: 15rem minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .layer h3 {
    margin-bottom: 0.35rem;
  }
  .layer .tags {
    align-content: start;
  }
  .pattern {
    display: grid;
    gap: 2rem 3.5rem;
    padding-block: 3rem;
    border-top: 1.5px solid var(--ink);
    scroll-margin-top: 5rem;
  }
  @media (min-width: 66rem) {
    .pattern {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }
  }
  .pattern h3 {
    font-size: var(--step-3);
  }
  .pattern .facts > div {
    grid-template-columns: 1fr;
  }
  @media (min-width: 44rem) {
    .pattern .facts > div {
      grid-template-columns: 9rem 1fr;
    }
  }
  .controls {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .controls h3 {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }
  .sub {
    margin-top: 4rem;
    margin-bottom: 1.25rem;
  }
</style>
