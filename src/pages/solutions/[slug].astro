---
import Base from '../../layouts/Base.astro';
import UseCaseRow from '../../components/UseCaseRow.astro';
import Cta from '../../components/Cta.astro';
import { useCases, byIndustry, howFor, type UseCase } from '../../data/usecases';
import { industryBySlug } from '../../data/industries';
import { plain } from '../../data/plain';

export function getStaticPaths() {
  return useCases.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}
interface Props {
  u: UseCase;
}
const { u } = Astro.props;
const ind = industryBySlug[u.industry];
const kind = plain[u.pattern];
const siblings = byIndustry(u.industry).filter((x) => x.slug !== u.slug);
const related = [...siblings.filter((x) => x.pattern === u.pattern), ...siblings.filter((x) => x.pattern !== u.pattern)].slice(0, 4);
const benefits = u.benefits ?? kind.benefits;
const measures = u.measures ?? kind.measures;
const worksWith = u.integrates ?? ind.systems;
---

<Base title={u.name} description={u.summary}>
  <section class="band page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/solutions/">Solutions</a><span aria-hidden="true">/</span>
        <a href={`/industries/${ind.slug}/`}>{ind.name}</a>
      </nav>
      <h1>{u.name}</h1>
      <p class="lede">{u.summary}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap split">
      <div class="sections">
        <div class="stack">
          <h2 class="h">The challenge</h2>
          <p class="big">{u.problem ?? kind.challenge}</p>
        </div>
        {
          u.does ? (
            <div class="stack">
              <h2 class="h">What the agent does</h2>
              <ul class="ticks">
                {u.does.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          ) : (
            <div class="stack">
              <h2 class="h">How it works</h2>
              <ol class="steps">
                {howFor(u).map((s, i) => (
                  <li>
                    <span>{i + 1}</span>
                    {s}
                  </li>
                ))}
              </ol>
            </div>
          )
        }
        <div class="stack">
          <h2 class="h">Your people stay in control</h2>
          <p class="big">{u.gate ?? kind.control}</p>
        </div>
      </div>

      <aside class="benefits">
        <h2 class="h">What you gain</h2>
        <ul>
          {benefits.map((b) => <li>{b}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section-tight detail">
    <div class="wrap cols">
      <div>
        <h2 class="h">{u.integrates ? 'Works with' : `Systems we work with in ${ind.name}`}</h2>
        <ul class="ticks">
          {worksWith.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="h">How we measure success</h2>
        <ul class="ticks">
          {measures.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="h">Kind of work</h2>
        <p class="muted">{kind.label}. {kind.summary}</p>
        <p class="small" style="margin-top:1rem"><a href={`/technology/#${u.pattern}`}>Technical design, for technical readers</a></p>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <h2 class="h" style="margin-bottom:1.25rem">
            More in {ind.name}
          </h2>
          <div class="uc-list">
            {related.map((r) => (
              <UseCaseRow u={r} />
            ))}
          </div>
          <p style="margin-top:1.5rem">
            <a href={`/industries/${ind.slug}/`}>
              All {siblings.length + 1} {ind.name} solutions
            </a>
          </p>
        </div>
      </section>
    )
  }

  <Cta heading={`Want this working in your ${ind.slug === 'accounting-audit' ? 'firm' : 'organisation'}?`} text="We can show it working on real examples from your business before you commit to a full build." />
</Base>

<style>
  .page-hero h1 {
    max-width: 22ch;
  }
  .h {
    font-size: var(--step-2);
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .sections > * + * {
    margin-top: 2.75rem;
  }
  .big {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .steps li:first-child {
    border-top: 1.5px solid var(--ink);
  }
  .steps span {
    font-weight: 700;
    font-stretch: 120%;
    color: var(--green-500);
  }
  .benefits {
    background: var(--green-900);
    color: #e9f0ea;
    border-radius: 8px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .benefits .h {
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .benefits li {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    font-size: var(--step-1);
    line-height: 1.35;
    font-weight: 500;
  }
  .benefits li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  @media (min-width: 62rem) {
    .benefits {
      position: sticky;
      top: 5.5rem;
    }
  }
  .detail {
    background: var(--white);
    border-block: 1px solid var(--line);
  }
  .cols {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .cols .h {
    font-size: var(--step-1);
    margin-bottom: 1rem;
    padding-top: 1rem;
    border-top: 1.5px solid var(--ink);
  }
  .cols li {
    color: var(--muted);
  }
</style>
