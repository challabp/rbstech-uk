---
import Base from '../layouts/Base.astro';
import UseCaseRow from '../components/UseCaseRow.astro';
import Cta from '../components/Cta.astro';
import { industries } from '../data/industries';
import { patterns } from '../data/patterns';
import { plain } from '../data/plain';
import { byIndustry, byPattern, counts, useCaseBySlug } from '../data/usecases';
import { headline, controls, phases } from '../data/stack';

// Everyday examples for the top of the page, each linking to a solution.
const examples = [
  { text: 'Answer customer calls and messages at any hour', slug: 'phone-answering-agent' },
  { text: 'Read invoices and enter them into your finance system', slug: 'vendor-invoice-processing-agent' },
  { text: 'Chase clients for missing documents', slug: 'pbc-request-and-evidence-agent' },
  { text: 'Review contracts against your standard terms', slug: 'contract-redline-agent' },
  { text: 'Investigate suspicious payments', slug: 'fraud-investigation-agent' },
  { text: 'Warn you about late shipments and suggest a fix', slug: 'shipment-exception-agent' },
];

// A spread across industries, in no order of priority.
const featured = [
  'clinical-intake-and-triage-agent',
  'new-claim-intake-agent',
  'new-customer-identity-check-agent',
  'predictive-maintenance-agent',
  'tax-return-preparation-agent',
  'employee-hr-helpdesk-agent',
  'returns-and-exchange-agent',
  'travel-disruption-recovery-agent',
];

const find = (slug: string) => {
  const u = useCaseBySlug[slug];
  if (!u) throw new Error(`Home page links to a solution that does not exist: ${slug}`);
  return u;
};
---

<Base title="Home">
  <section class="band hero">
    <div class="wrap hero-grid">
      <div>
        <h1>AI that takes routine work off your team.</h1>
        <p class="lede">
          We build AI agents: software that reads documents, answers questions and completes everyday tasks in the systems you already use. Your people stay in charge of the important decisions.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/solutions/">Browse the solutions</a>
          <a class="btn btn-ghost" href="/contact/">Start a conversation</a>
        </div>
      </div>
      <div class="examples">
        <h2>Work an AI agent can take on</h2>
        <ul>
          {
            examples.map((e) => (
              <li>
                <a href={`/solutions/${find(e.slug).slug}/`}>{e.text}</a>
              </li>
            ))
          }
        </ul>
        <p><a href="/solutions/">See all {counts.useCases} solutions</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Solutions for {counts.industries} industries.</h2>
        <p class="lede">Choose your industry to see the problems we solve, the benefits, and how your people stay in control.</p>
      </div>
      <ul class="ind-list">
        {
          industries.map((i) => (
            <li>
              <a href={`/industries/${i.slug}/`}>
                <span class="ind-name">{i.name}</span>
                <span class="ind-line">{i.line}</span>
                <span class="ind-n narrow">{byIndustry(i.slug).length} solutions</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section white">
    <div class="wrap">
      <div class="head">
        <h2>A few examples.</h2>
        <p class="lede">Each solution explains the problem, what the agent does and what you gain. Open any one to read more.</p>
      </div>
      <div class="uc-list">
        {featured.map((slug) => <UseCaseRow u={find(slug)} showIndustry />)}
      </div>
      <p style="margin-top:2rem"><a class="btn btn-solid" href="/solutions/">See all {counts.useCases} solutions</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Nine kinds of work AI agents do well.</h2>
        <p class="lede">Most routine work falls into one of these. If you recognise yours, an agent can probably help.</p>
      </div>
      <div class="kinds">
        {
          patterns.map((p) => (
            <a href={`/solutions/?pattern=${p.slug}`}>
              <h3>{plain[p.slug].label}</h3>
              <p class="muted">{plain[p.slug].summary}</p>
              <span class="narrow">{byPattern(p.slug).length} solutions</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band section">
    <div class="wrap">
      <div class="head">
        <h2>Safe to rely on.</h2>
        <p class="lede">An AI agent is only useful if you can trust it with real work. These safeguards are part of everything we build.</p>
      </div>
      <div class="three">
        {
          controls.map((c) => (
            <div>
              <h3>{c.name}</h3>
              <p class="muted">{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section white">
    <div class="wrap">
      <div class="head">
        <h2>How we work with you.</h2>
        <p class="lede">You see the agent working on your own data before you commit to the full build. Timelines depend on the work and are agreed with you after scoping.</p>
      </div>
      <ol class="phases">
        {
          phases.map((p, i) => (
            <li>
              <span class="phase-n">{i + 1}</span>
              <h3>{p.name}</h3>
              <p class="muted">{p.text}</p>
            </li>
          ))
        }
      </ol>
      <p style="margin-top:2.5rem"><a href="/approach/">More about how we work</a></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap tech">
      <div>
        <h2>The best technology for each job.</h2>
        <p class="lede" style="margin-top:1rem">We are not tied to any one supplier. We choose the AI and the cloud that fit your work and your existing systems.</p>
      </div>
      <div>
        <ul class="tags big-tags">
          {headline.map((h) => <li class="tag">{h}</li>)}
        </ul>
        <p style="margin-top:1.25rem"><a href="/technology/">Technology, for technical readers</a></p>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3.5rem, 8vw, 6.5rem);
  }
  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 4.5rem;
    }
  }
  .hero h1 {
    max-width: 12ch;
  }
  .hero .lede {
    margin-top: 1.75rem;
  }
  .hero .btn-row {
    margin-top: 2.25rem;
  }
  .examples h2 {
    font-size: var(--step-1);
    letter-spacing: 0;
    line-height: 1.3;
    color: #a9c0b3;
    font-weight: 500;
    font-stretch: 100%;
    margin-bottom: 0.75rem;
  }
  .examples ul {
    border-top: 1px solid rgba(255, 255, 255, 0.35);
  }
  .examples li a {
    display: block;
    padding: 0.95rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    text-decoration: none;
    font-size: var(--step-2);
    font-weight: 600;
    font-stretch: 106%;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .examples li a:hover {
    color: var(--marigold);
  }
  .examples p {
    margin-top: 1.25rem;
  }

  .white {
    background: var(--white);
    border-block: 1px solid var(--line);
  }

  .ind-list {
    border-top: 1.5px solid var(--ink);
  }
  .ind-list a {
    display: grid;
    gap: 0.15rem 2rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    align-items: baseline;
  }
  @media (min-width: 52rem) {
    .ind-list a {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr) 7rem;
    }
    .ind-n {
      text-align: right;
    }
  }
  .ind-name {
    font-size: var(--step-2);
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .ind-line {
    color: var(--muted);
  }
  .ind-n {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .ind-list a:hover {
    background: var(--white);
    box-shadow: -1rem 0 0 var(--white), 1rem 0 0 var(--white);
  }
  .ind-list a:hover .ind-name {
    color: var(--green-700);
  }

  .kinds {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0 2.5rem;
  }
  .kinds a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 0 1.75rem;
    border-top: 1.5px solid var(--ink);
    text-decoration: none;
  }
  .kinds h3 {
    font-size: var(--step-2);
  }
  .kinds a:hover h3 {
    color: var(--green-700);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .kinds span {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .three {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .three h3 {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }

  .phases {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .phases li {
    border-top: 1.5px solid var(--ink);
    padding-top: 1rem;
  }
  .phases h3 {
    margin-bottom: 0.6rem;
  }
  .phase-n {
    display: block;
    font-size: var(--step-4);
    font-weight: 700;
    font-stretch: 125%;
    color: var(--green-500);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .tech {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .tech {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }
  .tech h2 {
    font-size: var(--step-3);
  }
  .big-tags .tag {
    font-size: 1rem;
    padding: 0.5rem 0.75rem;
  }
</style>
