---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { phases } from '../data/stack';

const audiences = [
  {
    name: 'Businesses',
    who: 'Organisations with work that keeps growing faster than the team that does it.',
    get: 'An AI agent working in your own systems, tested on your own cases, with your people approving the important decisions.',
  },
  {
    name: 'Investors',
    who: 'Investment firms that own several companies and want each of them to run more efficiently.',
    get: 'A solution that is built once and then introduced company by company, with the same safeguards in each.',
  },
  {
    name: 'Partners',
    who: 'Software companies and consultancies that want to offer AI agents to their own customers.',
    get: 'Agents built into your product or delivered under your name, with everything your team needs to maintain them.',
  },
];

const deliverables = [
  'A clear written plan of what the agent will do and where your people approve',
  'A set of real test cases, agreed with your experts, that the agent must pass',
  'The working agent, running in your own systems',
  'Reports showing how well it is performing and what it costs to run',
  'A guide for your team, including how to pause the agent and return to the manual process',
  'Ownership of everything we build for you',
];

const principles = [
  {
    name: 'Start with the work',
    text: 'We watch how the work is really done before we design anything. The unusual cases that people handle without thinking are usually what decides whether an agent succeeds.',
  },
  {
    name: 'Measure against your experts',
    text: 'We test the agent on real cases that your own people have already answered. If it cannot match them where it matters, we tell you early.',
  },
  {
    name: 'Automate step by step',
    text: 'A new agent starts by preparing work for a person to approve. It is allowed to act on its own only when the results show it can be trusted, one kind of action at a time.',
  },
  {
    name: 'Build it so you can run it',
    text: 'We use widely adopted technology and document our decisions, so your own team can run and change what we deliver.',
  },
];
---

<Base title="How we work" description="How RBS Technologies works with you: scoping, proof on your own data, build and launch, and support. Timelines are agreed after scoping.">
  <section class="band page-hero">
    <div class="wrap">
      <h1>See it work on your own data before you commit.</h1>
      <p class="lede">We start with one piece of work and one clear goal, show you the agent working early, and launch only when it passes the tests we agreed with you.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>Four stages.</h2>
        <p class="lede">How long each stage takes depends on how complex the work is. We agree the timeline and the price with you at the end of scoping, before any build begins.</p>
      </div>
      <ol class="timeline">
        {
          phases.map((p, i) => (
            <li>
              <span class="n">{i + 1}</span>
              <h3>{p.name}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section white">
    <div class="wrap split">
      <div>
        <h2>What you have at the end.</h2>
        <p class="lede" style="margin-top:1.25rem">Everything you need to run the agent yourselves, whether or not you choose to.</p>
      </div>
      <ul class="ticks big">
        {deliverables.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <h2>What we believe.</h2>
      </div>
      <div class="grid">
        {
          principles.map((p) => (
            <div>
              <h3>{p.name}</h3>
              <p class="muted">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band section">
    <div class="wrap">
      <div class="head">
        <h2>Who we work with.</h2>
      </div>
      <div class="aud">
        {
          audiences.map((a) => (
            <div>
              <h3>{a.name}</h3>
              <p>{a.who}</p>
              <p class="muted"><strong>What you get:</strong> {a.get}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Cta heading="Start with a conversation." text="Tell us about the work. We will tell you honestly whether we think an AI agent can do it, and what the first step would be." />
</Base>

<style>
  .white {
    background: var(--white);
    border-block: 1px solid var(--line);
  }
  .timeline {
    border-top: 1.5px solid var(--ink);
  }
  .timeline li {
    display: grid;
    gap: 0.75rem 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .timeline li {
      grid-template-columns: 5rem minmax(0, 4fr) minmax(0, 6fr);
    }
  }
  .timeline .n {
    font-size: var(--step-4);
    font-weight: 700;
    font-stretch: 125%;
    line-height: 0.9;
    color: var(--green-500);
  }
  .timeline li > p {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .big {
    font-size: var(--step-1);
  }
  .grid,
  .aud {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }
  .grid h3,
  .aud h3 {
    margin-bottom: 0.6rem;
  }
  .grid h3 {
    font-size: var(--step-1);
  }
  .aud > div {
    border-top: 4px solid var(--marigold);
    padding-top: 1.25rem;
  }
  .aud p + p {
    margin-top: 0.9rem;
  }
  .aud strong {
    color: #fff;
  }
</style>
