---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="band page-hero">
    <div class="wrap">
      <h1>That page does not exist.</h1>
      <p class="lede">The address may have changed. The solutions catalogue is the best place to pick up from.</p>
      <div class="btn-row" style="margin-top:2rem">
        <a class="btn btn-primary" href="/solutions/">Browse the solutions</a>
        <a class="btn btn-ghost" href="/">Go to the home page</a>
      </div>
    </div>
  </section>
</Base>
